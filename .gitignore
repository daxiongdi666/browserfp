.venv/
__pycache__/
oracle/gotls/browserfp-probe
oracle/gotls/hrrserver/hrrserver
oracle/goutls/browserfp-utls
oracle/gosurf/browserfp-surf
csrc/*.o
csrc/*.so
csrc/ja4cli
csrc/lookup_test
csrc/buildcli
csrc/h2cli
csrc/kscli
csrc/idcli
csrc/cohcli
csrc/fuzzcli
csrc/*.dSYM
csrc/uacli
csrc/snitest
csrc/kxcli
csrc/profiles.inc
spec/cache/
csrc/hrrcli
oracle/gotls/h2echo/h2echo
oracle/gotls/kybercli/kybercli
oracle/gotls/kyberserver/kyberserver
oracle/gotls/h2strict/h2strict
oracle/gotls/h2early/h2early
csrc/uastrcli

# ---- 编译产物与本地环境：**都栽过，别再提交进来** ----
# .venv-wreq 曾被提交进 git：874 个文件 35MB，占仓库的 91%，全是别人的编译 wheel
# （cryptography / wreq / aioquic）。抽独立仓时靠 git filter-repo 才拔掉。
.venv*/
__pycache__/
*.pyc

# Go 测试服务端的编译产物。源码在仓里，用 go build 现编即可。
# 历史里躺过几个 go build 产物（probe / utls / hrrserver，合计 ~28MB），
# 而且是 macOS arm64 的 —— 换个平台根本用不了。
oracle/gotls/*/[a-z]*
!oracle/gotls/*/*.go
!oracle/gotls/*/go.*
oracle/goutls/*[!.]*
!oracle/goutls/*.go
!oracle/goutls/go.*

# C 构建产物
csrc/*.o
csrc/*.so
csrc/*.dylib
csrc/profiles.inc
csrc/*.dSYM/

# 联网门禁的抓包缓存（154MB）
spec/cache/

# Node.js 绑定
node/node_modules/
node/package-lock.json
node/yarn.lock
